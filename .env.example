# API key/secret pairs, each bound to one organization id: key:secret:organization_id, comma-separated.
# (A JSON list [{"key":..,"secret":..,"organization_id":..}] also works, but DigitalOcean rejects braces.)
DIDOMI_SIM_KEYS=demo-key:demo-secret:demo-org
# HS256 signing secret for access tokens (use 32+ random bytes).
DIDOMI_SIM_JWT_SECRET=change-me-to-a-long-random-string-of-32-bytes
# Population: same seed => same users and events.
DIDOMI_SIM_SEED=didomi-sim
DIDOMI_SIM_USERS=3000
# Timeline: users are created over [ANCHOR - PAST_DAYS, ANCHOR + FUTURE_DAYS).
DIDOMI_SIM_ANCHOR=2026-10-27
DIDOMI_SIM_PAST_DAYS=180
DIDOMI_SIM_FUTURE_DAYS=60
# Incident window: opt-in rates drop to 35% of normal for events from this source type.
# Leave DIDOMI_SIM_INCIDENT_START empty to disable.
DIDOMI_SIM_INCIDENT_START=2026-10-13
DIDOMI_SIM_INCIDENT_DAYS=5
DIDOMI_SIM_INCIDENT_SOURCE=sdk-mobile
# Optional frozen clock (ISO 8601). Unset = real UTC time.
# DIDOMI_SIM_NOW=2026-10-27T12:00:00Z
